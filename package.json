{
  "name": "md-graph-studio",
  "displayName": "Markdown Graph Studio",
  "description": "Edit semantic Markdown graphs entirely inside VS Code.",
  "icon": "media/icon.png",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TinhSsc/md-graph-studio.git"
  },
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Visualization", "Other"],
  "activationEvents": ["onCommand:markdownGraphStudio.openAsGraph", "onCustomEditor:markdownGraphStudio.editor", "onView:markdownGraphStudio.canvases"],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Markdown Graph Studio",
      "properties": {
        "markdownGraphStudio.storageMode": {
          "type": "string",
          "enum": ["sidecar", "embedded", "stateless"],
          "default": "sidecar",
          "description": "Storage strategy for canvas layout metadata. 'sidecar' stores layout in .md.graph.json, keeping Markdown completely clean."
        },
        "markdownGraphStudio.sidecarNaming": {
          "type": "string",
          "enum": ["dot-md-graph-json", "dot-graph-json"],
          "default": "dot-md-graph-json",
          "description": "Naming convention for sidecar files: 'foo.md.graph.json' or 'foo.graph.json'."
        }
      }
    },
    "commands": [
      { "command": "markdownGraphStudio.openAsGraph", "title": "Markdown Graph Studio: Open as Graph" },
      { "command": "markdownGraphStudio.openSideBySide", "title": "Markdown Graph Studio: Open Text and Graph Side by Side" },
      { "command": "markdownGraphStudio.pickCanvas", "title": "Markdown Graph Studio: Open Canvas", "icon": "$(folder-opened)" },
      { "command": "markdownGraphStudio.refreshCanvases", "title": "Markdown Graph Studio: Refresh Canvases", "icon": "$(refresh)" },
      { "command": "markdownGraphStudio.convertToSidecar", "title": "Markdown Graph Studio: Convert to Sidecar Storage" },
      { "command": "markdownGraphStudio.embedMetadata", "title": "Markdown Graph Studio: Embed Metadata into Markdown" },
      { "command": "markdownGraphStudio.searchNodes", "title": "Search Nodes", "icon": "$(search)" },
      { "command": "markdownGraphStudio.clearNodeFilter", "title": "Clear Filter", "icon": "$(clear-all)" },
      { "command": "markdownGraphStudio.removeCanvas", "title": "Remove from Recent Canvases", "icon": "$(close)" },
      { "command": "markdownGraphStudio.clearRecentCanvases", "title": "Clear All Recent Canvases", "icon": "$(clear-all)" },
      { "command": "markdownGraphStudio.closeOutline", "title": "Close Node Outline", "icon": "$(close)" }
    ],
    "viewsContainers": {
      "activitybar": [{
        "id": "markdownGraphStudio",
        "title": "Markdown Graph Studio",
        "icon": "media/graph-studio.svg"
      }]
    },
    "views": {
      "markdownGraphStudio": [
        { "id": "markdownGraphStudio.canvases", "name": "Canvases" },
        { "id": "markdownGraphStudio.outline", "name": "Node" }
      ]
    },
    "viewsWelcome": [{
      "view": "markdownGraphStudio.canvases",
      "contents": "No canvas opened yet.\n[Open Markdown Canvas](command:markdownGraphStudio.pickCanvas)"
    }, {
      "view": "markdownGraphStudio.outline",
      "contents": "Open a canvas to see its nodes."
    }],
    "menus": {
      "view/title": [{
        "command": "markdownGraphStudio.pickCanvas",
        "when": "view == markdownGraphStudio.canvases",
        "group": "navigation"
      }, {
        "command": "markdownGraphStudio.refreshCanvases",
        "when": "view == markdownGraphStudio.canvases",
        "group": "navigation"
      }, {
        "command": "markdownGraphStudio.clearRecentCanvases",
        "when": "view == markdownGraphStudio.canvases",
        "group": "navigation"
      }, {
        "command": "markdownGraphStudio.closeOutline",
        "when": "view == markdownGraphStudio.outline",
        "group": "navigation"
      }, {
        "command": "markdownGraphStudio.searchNodes",
        "when": "view == markdownGraphStudio.outline",
        "group": "navigation"
      }, {
        "command": "markdownGraphStudio.clearNodeFilter",
        "when": "view == markdownGraphStudio.outline && markdownGraphStudio.hasNodeFilter",
        "group": "navigation"
      }],
      "view/item/context": [{
        "command": "markdownGraphStudio.removeCanvas",
        "when": "view == markdownGraphStudio.canvases && viewItem == canvasItem",
        "group": "inline"
      }, {
        "command": "markdownGraphStudio.removeCanvas",
        "when": "view == markdownGraphStudio.canvases && viewItem == canvasItem",
        "group": "1_modification"
      }]
    },
    "customEditors": [{
      "viewType": "markdownGraphStudio.editor",
      "displayName": "Markdown Graph Studio",
      "selector": [{ "filenamePattern": "*.md" }],
      "priority": "option"
    }]
  },
  "scripts": {
    "build": "node esbuild.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run check && npm test && npm run build",
    "package": "npm run verify && vsce package --no-dependencies --allow-missing-repository --out dist/markdown-graph-studio.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.24.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
